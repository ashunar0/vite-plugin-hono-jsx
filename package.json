{
  "name": "vite-plugin-hono-jsx",
  "version": "0.1.0",
  "description": "The Vite plugin for hono/jsx",
  "license": "MIT",
  "author": "ashunar0",
  "homepage": "https://github.com/ashunar0/vite-plugin-hono-jsx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashunar0/vite-plugin-hono-jsx.git"
  },
  "bugs": "https://github.com/ashunar0/vite-plugin-hono-jsx/issues",
  "keywords": [
    "hono",
    "hono/jsx",
    "jsx",
    "hmr",
    "vite",
    "vite-plugin"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite example",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "pnpm build",
    "e2e": "node e2e/basic.mjs"
  },
  "peerDependencies": {
    "hono": "^4.13.1",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "magic-string": "^1.4.5"
  },
  "devDependencies": {
    "hono": "^4.13.16",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
